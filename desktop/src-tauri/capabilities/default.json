{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the playground page may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-ask",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://kerfscript.mylasertools.com/*" },
        { "url": "https://mylasertools.com/*" },
        { "url": "https://github.com/mylasertools/kerfscript" },
        { "url": "https://github.com/mylasertools/kerfscript/*" },
        { "url": "https://www.npmjs.com/package/@mylasertools/kerfscript" }
      ]
    }
  ]
}
