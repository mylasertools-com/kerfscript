# The desktop app's menu entry for the .deb and .rpm (bundle.linux in
# desktop/src-tauri/tauri.conf.json). Tauri's own template, with %f added so
# that a double-clicked .kerf file is passed to the app.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %f
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
