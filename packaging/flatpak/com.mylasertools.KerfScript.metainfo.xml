<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.mylasertools.KerfScript</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>KerfScript</name>
  <summary>Design parametric parts for laser cutting in code</summary>
  <developer id="com.mylasertools">
    <name>MyLaserTools</name>
  </developer>
  <description>
    <p>
      KerfScript is a programming language for laser cutting. Write parametric
      2D parts with cut, score and engrave layers, and see the result as you
      type.
    </p>
    <ul>
      <li>Kerf compensation, so parts fit together at the size you wrote</li>
      <li>Finger joints, slots and living hinges from the standard library</li>
      <li>Sliders and switches made from comments in the code</li>
      <li>Parts packed onto sheets, with one SVG or DXF file per sheet</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.mylasertools.KerfScript.desktop</launchable>
  <url type="homepage">https://kerfscript.mylasertools.com</url>
  <url type="bugtracker">https://github.com/mylasertools/kerfscript/issues</url>
  <url type="vcs-browser">https://github.com/mylasertools/kerfscript</url>
  <url type="help">https://kerfscript.mylasertools.com/docs/</url>
  <screenshots>
    <screenshot type="default">
      <image>https://kerfscript.mylasertools.com/screenshots/desktop.png</image>
      <caption>A design with its settings and the cut file</caption>
    </screenshot>
  </screenshots>
  <categories>
    <category>Graphics</category>
    <category>Engineering</category>
  </categories>
  <keywords>
    <keyword>laser</keyword>
    <keyword>cutting</keyword>
    <keyword>CAD</keyword>
    <keyword>SVG</keyword>
    <keyword>DXF</keyword>
  </keywords>
  <provides>
    <mediatype>text/x-kerfscript</mediatype>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
