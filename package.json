{
  "name": "@mylasertools/kerfscript",
  "version": "0.2.0",
  "description": "KerfScript: a programming language for laser cutting. Write parametric 2D parts with cut, score and engrave layers, kerf compensation and joinery, and export SVG or DXF.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "MyLaserTools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylasertools-com/kerfscript.git"
  },
  "bugs": "https://github.com/mylasertools-com/kerfscript/issues",
  "keywords": [
    "kerfscript",
    "laser-cutting",
    "parametric",
    "cad",
    "programming-language",
    "svg",
    "dxf",
    "finger-joints",
    "living-hinge",
    "kerf"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "kerf": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LANGUAGE.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md",
    "TRADEMARKS.md",
    "CLA.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/stdlib.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "node --test",
    "check": "npm run build && npm test",
    "examples": "node scripts/examples.mjs",
    "site": "npm run build && npm --prefix site run build",
    "site:serve": "npm --prefix site run preview",
    "prepack": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compat": "node scripts/compat.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "clipper2-ts": "2.0.1-18",
    "esbuild": "0.25.12",
    "marked": "15.0.12",
    "opentype.js": "1.3.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "homepage": "https://kerfscript.mylasertools.com"
}
