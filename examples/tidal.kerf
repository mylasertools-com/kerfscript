// Tidal: a hand-cranked wave automaton. Round cams sit off-centre on a
// square shaft, each turned a little further than the last, so as you turn
// the crank they lift seven fins one after another and the fins ripple
// like a wave.

/* [Motion] */
// Number of fins
fins = 7; // [5:1:9]
// How far each cam sits off the shaft; the fins rise and fall twice this
lift = 8; // [5:1:10]
// How much further each cam is turned than the one before, in degrees
phase = 45; // [15:5:180]

/* [Structure] */
// Distance between fins, in sheet thicknesses
pitch_layers = 9; // [8:1:11]
// Total play for the parts that slide or turn
clearance = 0.4; // [0.2:0.1:0.6]
// Added to the square holes for the 6 mm shaft
shaft_fit = 0.15; // [0.05:0.05:0.3]

/* [Export] */
// All parts, or one group at a time
output = "all"; // [all:All parts, frame:Frame, cams:Cams, followers:Fins, spacers:Spacer rings, crank:Crank, coupon:Fit test, timing:Timing card]

/* [Material] */
// Sheet thickness
$thickness = 3; // [2.8:0.1:3.2]
// Beam width
$kerf = 0.15; // [0:0.01:0.25]

/* [Hidden] */
$material = "plywood";
$sheet = [600, 400];
$gap = 5;
$fn = 120;
t = $thickness;
pitch = pitch_layers * t;
camT = 3 * t;
followerT = 2 * t;
margin = 8 * t;
inner = 2 * margin + camT + (fins - 1) * pitch + 0.8;
overall = inner + 6 * t;
shaft_z = 45;
R = 22;
guides = [90, 126];
stem = 12;
foot = 38;
assert(fins == floor(fins) && fins >= 5 && fins <= 9, "Fins: 5 to 9");
assert(lift >= 5 && lift <= 10, "Lift: 5 to 10 mm");
assert(phase >= 15 && phase <= 180, "Phase: 15 to 180 degrees");
assert(pitch_layers == floor(pitch_layers) && pitch_layers >= 8 && pitch_layers <= 11, "Pitch: 8 to 11 layers");
assert(clearance >= 0.2 && clearance <= 0.6, "Clearance: 0.2 to 0.6 mm");
assert(shaft_fit >= 0.05 && shaft_fit <= 0.3, "Shaft fit: 0.05 to 0.3 mm");
assert(t >= 2.8 && t <= 3.2, "Thickness: 2.8 to 3.2 mm");
assert($kerf >= 0 && $kerf <= 0.25, "Kerf: 0 to 0.25 mm");
assert(contains(["all", "frame", "cams", "followers", "spacers", "crank", "coupon", "timing"], output), "Unknown output");

// Where fin i stands along the shaft
function station(i) = 3 * t + margin + camT / 2 + i * pitch;

module square_bore(a = 0) {
  rotate(a) rect([6 + shaft_fit, 6 + shaft_fit], center = true);
}

// Tally marks: i short scored bars
module mark(i, p) {
  score() for (j = [0:i - 1]) translate([p[0] + 2 * j, p[1]]) rect([0.3, 4]);
}

module base() {
  difference() {
    rect([overall, 110], r = 4);
    for (x = [1.5 * t, overall - 1.5 * t], y = [20, 90]) translate([x, y]) rect([3 * t + 0.2, 14.2], center = true);
  }
}

module end_wall() {
  difference() {
    union() {
      translate([-55, 2 * t]) rect([110, 145 - 2 * t], r = 4);
      for (y = [-35, 35]) translate([y - 7, 0]) rect([14, 2 * t + 5]);
    }
    translate([0, shaft_z]) circle(d = 18 + clearance);
    for (z = guides, y = [-30, 30]) translate([y, z + t / 2]) rect([12.2, t + 0.2], center = true);
    // Windows below the guides
    for (y = [-35, 35]) translate([y - 9, 55]) rect([18, 24], r = 5);
  }
}

// Half a guide: two halves close around the fin stems
module guide_half() {
  difference() {
    union() {
      rect([inner, 45]);
      for (x = [-2 * t, inner]) translate([x, 9]) rect([2 * t + 1, 12]);
    }
    for (i = [0:fins - 1]) translate([margin + camT / 2 + i * pitch, 45]) rect([followerT + clearance, stem + clearance], center = true);
  }
}

// Cam i: its square hole is turned back by i * phase, so on the shaft its
// offset points i * phase further round than cam 1
module cam(i) {
  difference() {
    translate([lift, 0]) circle(r = R);
    square_bore(-i * phase);
    for (y = [-11, 11]) translate([lift, y]) circle(d = 3.1);
  }
}

// A fin with its straight stem and the flat foot that rides on the cam
module follower() {
  union() {
    translate([-foot / 2, 0]) rect([foot, 6], r = 1);
    // Round the fin's outer corners, then fillet where it meets the stem
    offset(r = -6) offset(delta = 6) union() {
      translate([-stem / 2, 4]) rect([stem, 108]);
      offset(r = 14) offset(delta = -14)
        polygon([[-6, 108], [-17, 118], [-34, 133], [-40, 145], [-30, 155], [-10, 164], [0, 166], [10, 164], [30, 155], [40, 145], [34, 133], [17, 118], [6, 108]]);
    }
  }
}

module crank() {
  difference() {
    hull() {
      circle(r = 16);
      translate([0, 30]) circle(r = 10);
    }
    square_bore();
    translate([0, 30]) circle(d = 4.5);
  }
}

if (output == "all" || output == "frame") {
  part("Base", qty = 2) base();
  part("End wall", qty = 6) end_wall();
  part("Guide half", qty = 4) guide_half();
  part("Journal", qty = 6) difference() {
    circle(d = 18);
    square_bore();
  }
  part("Thrust washer", qty = 4) difference() {
    circle(d = 26);
    circle(d = 9.2);
  }
}
if (output == "all" || output == "cams") for (i = [0:fins - 1]) part(str("Cam ", i + 1), qty = 3) {
  cam(i);
  mark(i + 1, [lift - 7, 12]);
  score() translate([lift, 0]) outline() circle(r = 16);
}
if (output == "all" || output == "followers") for (i = [0:fins - 1]) part(str("Fin ", i + 1), qty = 2) {
  follower();
  mark(i + 1, [-8, 145]);
  score() translate([0, 150]) outline() circle(d = 12);
}
if (output == "all" || output == "spacers") part("Spacer ring", qty = 16 + (fins - 1) * (pitch_layers - 3)) difference() {
  circle(d = 14);
  circle(d = 9.2);
}
if (output == "all" || output == "crank") {
  part("Crank", qty = 3) crank();
  part("Handle", qty = 6) difference() {
    circle(d = 18);
    circle(d = 4.5);
  }
}
if (output == "all" || output == "coupon") part("Fit test") {
  difference() {
    rect([110, 48], r = 3);
    for (j = [0:3]) translate([15 + 25 * j, 16]) rect([6.05 + 0.1 * j, 6.05 + 0.1 * j], center = true);
    translate([25, 34]) circle(d = 18 + clearance);
    translate([64, 34]) rect([followerT + clearance, stem + clearance], center = true);
  }
  for (j = [0:3]) mark(j + 1, [12 + 25 * j, 4]);
}
// Which way each cam's offset points, seen from the crank side
if (output == "all" || output == "timing") part("Timing card") {
  rect([48 * fins, 56], r = 3);
  for (i = [0:fins - 1]) {
    p = [24 + 48 * i, 28];
    a = i * phase;
    score() translate(p) outline() circle(r = 20);
    score() translate(p) outline() rect([6, 6], center = true);
    score() hull() {
      translate(p) circle(d = 0.4);
      translate(p + [14 * cos(a), 14 * sin(a)]) circle(d = 0.4);
    }
    score() translate(p + [14 * cos(a), 14 * sin(a)]) outline() circle(d = 3);
    mark(i + 1, [p[0] - 8, 4]);
  }
}

echo(str("Body ", overall, " x 110 mm; square shaft at least ", overall + 75, " mm long"));

// Assembly: glue the laminations (base 2, each end wall 3, each cam 3, each
// fin 2, each journal 3, crank 3, handle 6). Thread the rotor onto the square
// shaft: journal, 8 spacer rings, cam 1, 6 rings, cam 2 ... cam 7, 8 rings,
// journal, every cam set to the timing card. Stand the end walls in the base
// with the journals in their round holes, set each fin's foot on its cam and
// close the two guide halves around the stems at each level. Add two thrust
// washers outside each wall, the crank with its handle and a collar on one
// end, a collar on the other.
