---
const { model: m } = Astro.props;
---

<a class="model-card" href={`/models/${m.slug}/`}>
  <figure>
    {
      m.assembled ? (
        <img src={`/3d/${m.slug}.webp`} alt={`${m.title}, assembled`} loading="lazy" width="1200" height="900" />
      ) : (
        <Fragment set:html={m.thumb} />
      )
    }
  </figure>
  <div class="model-card-text">
    <h3>{m.title}</h3>
    <p>{m.summary}</p>
    <p class="meta">{m.lines} lines · {m.cardMeta}</p>
  </div>
</a>
