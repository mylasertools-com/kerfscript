---
import Base from '../../../layouts/Base.astro';
import { code, fmt, models } from '../../../lib/site.mjs';

const MODEL_VIEWER = 'https://cdn.jsdelivr.net/npm/@google/model-viewer@4.4.0/dist/model-viewer.min.js';

export function getStaticPaths() {
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model: m } = Astro.props;
const laser = m.laser.replace(/^<\?xml[^>]*>\s*/, '').replace(/ width="[^"]+mm" height="[^"]+mm"/, '');

function rangeText(p) {
  if (p.options) return p.options.map((o) => o.name).join(', ');
  if (p.min !== undefined && p.max !== undefined) return `${p.min} to ${p.max}`;
  if (p.type === 'boolean') return 'on or off';
  return '';
}
---

<Base
  title={`${m.title}, made with KerfScript`}
  description={`${m.summary} Customize this KerfScript design and download its source, SVG or DXF.`}
  scripts={m.glb ? ['/assets/views.js', MODEL_VIEWER] : ['/assets/views.js']}
  type="article"
>
  <p class="crumbs"><a href="/models/">Models</a> / {m.title}</p>
  <div class="model-head">
    <h1>{m.title}</h1>
    <p class="lede">{m.summary}</p>
  </div>
  <div class="model-layout">
    <section class="model-figure">
      {
        m.glb && (
          <figure class="sheet model-3d">
            <model-viewer
              src={`/3d/${m.slug}.glb`}
              poster={`/3d/${m.slug}.webp`}
              alt={`${m.title}, assembled, in 3D`}
              camera-controls
              autoplay
              auto-rotate
              auto-rotate-delay="2000"
              rotation-per-second="18deg"
              interaction-prompt="none"
              shadow-intensity="0.7"
              shadow-softness="0.9"
              exposure="1.05"
              environment-image="neutral"
              camera-orbit="-35deg 62deg auto"
            />
          </figure>
        )
      }
      <div class="model-flat" data-views>
        <div class="view-switch" role="tablist" aria-label="View">
          <button role="tab" aria-selected="true" data-view="material">Parts</button>
          <button role="tab" aria-selected="false" data-view="laser">Laser file</button>
        </div>
        <figure class="sheet" data-panel="material" set:html={m.display} />
        <figure class="sheet laser" data-panel="laser" hidden set:html={laser} />
        <p class="figure-note">
          {
            m.sheets === 1
              ? `Download size: ${fmt(m.width)} × ${fmt(m.height)} mm. ${m.count} ${m.count === 1 ? 'part' : 'parts'} on 1 sheet.`
              : `${m.count} parts on ${m.sheets} sheets, shown together. Each sheet has its own cut file.`
          }
        </p>
      </div>
      {
        m.photo && (
          <figure class="photo">
            <img src={`/photos/${m.slug}.webp`} alt={m.photo.alt} loading="lazy" width="900" height="600" />
          </figure>
        )
      }
    </section>
    <aside class="model-facts">
      <div class="actions">
        <a class="button primary" href={`/playground/?model=${m.slug}`}>Open in playground</a>
        <a class="button" href={`/models/${m.slug}/${m.slug}.kerf`} download>{m.slug}.kerf</a>
        {
          m.sheetFiles.length === 0 && (
            <>
              <a class="button" href={`/models/${m.slug}/${m.slug}.svg`} download>SVG</a>
              <a class="button" href={`/models/${m.slug}/${m.slug}.dxf`} download>DXF</a>
            </>
          )
        }
      </div>
      {
        m.sheetFiles.length > 0 && (
          <>
            <h2>Cut files</h2>
            <table class="parts sheet-files">
              <thead>
                <tr><th>Sheet</th><th>Size</th><th>Download</th></tr>
              </thead>
              <tbody>
                {m.sheetFiles.map((s, i) => (
                  <tr>
                    <td>
                      {i + 1}, {s.pieces} {s.pieces === 1 ? 'part' : 'parts'}
                    </td>
                    <td>
                      {fmt(s.width)} × {fmt(s.height)} mm
                    </td>
                    <td>
                      <a href={`/models/${m.slug}/${s.name}.svg`} download>SVG</a> ·{' '}
                      <a href={`/models/${m.slug}/${s.name}.dxf`} download>DXF</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )
      }
      <h2>Parts</h2>
      <table class="parts">
        <thead><tr><th>Part</th><th>Qty</th><th>Size</th></tr></thead>
        <tbody>
          {
            m.parts.map((p) => (
              <tr>
                <td>{p.name}</td>
                <td>{p.qty}</td>
                <td>
                  {fmt(p.width)} × {fmt(p.height)} mm
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {
        m.params.length > 0 && (
          <>
            <h2>Settings</h2>
            <table class="params">
              <thead>
                <tr><th>Setting</th><th>Default</th><th>Range</th></tr>
              </thead>
              <tbody>
                {m.params.map((p) => (
                  <tr>
                    <td>
                      <code>{p.name}</code>
                      {p.caption && <span>{p.caption}</span>}
                    </td>
                    <td>
                      <code>{JSON.stringify(p.initial)}</code>
                    </td>
                    <td>{rangeText(p)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )
      }
      <p class="facts-note">
        Set power, speed and cut order in your laser software. <a
          href="/docs/compatibility/">Laser software notes</a
        >
      </p>
    </aside>
  </div>
  <section class="source">
    <h2>Source <span class="meta">{m.lines} lines</span></h2>
    <Fragment set:html={code(m.source, { numbers: true })} />
  </section>
</Base>
