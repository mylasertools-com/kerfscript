---
import Base from '../../layouts/Base.astro';
import ModelCard from '../../components/ModelCard.astro';
import { models } from '../../lib/site.mjs';
---

<Base
  title="Models made with KerfScript"
  description="Browse KerfScript models for laser cutting. Customize boxes, gears, puzzles and signs, then download the source, SVG or DXF."
>
  <div class="page-head">
    <h1>Models</h1>
    <p class="lede">
      Choose a model to see its parts and source code. Customize it in the playground, or download
      the SVG or DXF with the default settings.
    </p>
  </div>
  <div class="model-grid">{models.map((m) => <ModelCard model={m} />)}</div>
</Base>
