---
import Base from '../../layouts/Base.astro';
import { GUIDES, markdown } from '../../lib/site.mjs';

const guides = GUIDES.map(([slug, label]) => ({ slug, label, lead: markdown(`docs/${slug}.md`).lead }));
---

<Base
  title="KerfScript documentation"
  description="Learn to design and export laser-cut parts with KerfScript. Guides to drawing, layers, kerf, materials and settings, plus the CLI and API reference."
>
  <div class="page-head">
    <h1>Documentation</h1>
    <p class="lede">
      Build your first part, add engraving and prepare a cut file. These guides explain each step.
      Use the <a href="/docs/reference/"
        >language reference</a
      > to look up syntax, functions and modules.
    </p>
  </div>
  <ol class="guide-list">
    {
      guides.map((g) => (
        <li>
          <a href={`/docs/${g.slug}/`}>{g.label}</a>
          <p>{g.lead}</p>
        </li>
      ))
    }
    <li>
      <a href="/docs/reference/">Language reference</a>
      <p>Syntax, built-in functions and modules, with parameter names and defaults.</p>
    </li>
  </ol>
</Base>
