---
import Base from '../layouts/Base.astro';
import { markdown } from '../lib/site.mjs';

const licence = markdown('COMMERCIAL-LICENSE.md').html;
const trademarks = markdown('TRADEMARKS.md').html;
const notices = markdown('THIRD-PARTY-NOTICES.md').html;
---

<Base
  title="KerfScript licence"
  description="KerfScript licensing: free to use under the GNU AGPL 3.0 or a free commercial licence, rights to your designs and exports, and use of the KerfScript name."
>
  <article class="prose narrow">
    <Fragment set:html={licence} />
    <hr />
    <Fragment set:html={trademarks} />
    <hr />
    <Fragment set:html={notices} />
  </article>
</Base>
