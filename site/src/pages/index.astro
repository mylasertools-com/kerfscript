---
import Base from '../layouts/Base.astro';
import ModelCard from '../components/ModelCard.astro';
import { NPM_URL, SOURCE_PUBLIC, code, highlight, models } from '../lib/site.mjs';

const hero = models.find((m) => m.slug === 'clock-face');
const featured = ['hadal', 'box', 'winterlight', 'gears', 'solstice', 'jigsaw'].map(
  (s) => models.find((m) => m.slug === s),
);

const photos = ['box', 'clock-face', 'gears', 'jigsaw'].map((s) => models.find((m) => m.slug === s));

const FEATURES = [
  [
    'Layers',
    'engrave() text("Oak", 12);',
    'Keep cuts, score lines and engraved areas on separate layers. Engraving stays within the part and clear of its holes.',
    '/docs/layers/',
  ],
  [
    'Kerf',
    '$kerf = 0.15;',
    'Set the measured width of your laser cut. KerfScript adjusts the outlines to account for the material removed by the beam.',
    '/docs/kerf/',
  ],
  [
    'Parts and sheets',
    'part("lid", qty = 2) lid();',
    'Name your parts, set quantities and choose a sheet size. Parts with the same material and thickness are laid out together.',
    '/docs/parts-and-sheets/',
  ],
  [
    'Joinery',
    'finger_rect([120, 50], "out");',
    'Build finger joints, slots and living hinges into your design. Joint dimensions follow the material thickness you set.',
    '/docs/reference/#joinery',
  ],
  [
    'Settings',
    'width = 120; // [40:5:400]',
    "Add sliders, menus and text fields with comments in your code. People can then customize the design without editing it.",
    '/docs/customizer/',
  ],
  [
    'Output',
    'kerf render box.kerf -o box.svg',
    'Export SVG or DXF in millimetres, with separate layers for cutting, scoring and engraving.',
    '/docs/compatibility/',
  ],
];
---

<Base
  title="KerfScript, a programming language for laser cutting"
  description="Design laser-cut parts in code. Adjust dimensions, add text and joints, and export SVG or DXF with KerfScript."
  scripts={['/assets/home.js']}
>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Parametric laser design</p>
      <h1>A programming language for laser cutting.</h1>
      <p class="lede">
        Design a part once, then change its size, text or material thickness whenever you need to.
        KerfScript handles the cut, score and engrave layers and exports your design as SVG or DXF.
      </p>
      <p class="hero-actions">
        <a class="button primary" href="/playground/">Open the playground</a>
        <a class="button" href="/models/">Browse the models</a>
      </p>
      <p class="hero-note">
        Start with a model and adjust its settings, or write your own design.
      </p>
    </div>
    <div class="hero-demo" data-demo data-model={hero.slug}>
      <div class="demo-tab"><span>{hero.slug}.kerf</span><span class="demo-time" data-time></span></div>
      <div class="demo-code" set:html={code(hero.source)} />
      <div class="demo-controls" data-controls></div>
      <figure class="demo-figure" data-figure set:html={hero.display} />
    </div>
  </section>

  <section class="steps">
    <h2>Start with a model</h2>
    <ol>
      <li>
        <h3>Choose a model</h3>
        <p>Browse the <a href="/models/">models</a> for boxes, signs, puzzles and other projects.</p>
      </li>
      <li>
        <h3>Change its settings</h3>
        <p>
          Adjust the dimensions, text or material settings in the playground. The preview updates as you edit.
        </p>
      </li>
      <li>
        <h3>Download the cut file</h3>
        <p>
          Save an SVG or DXF and open it in your laser software. See the <a href="/docs/compatibility/"
            >import guide</a
          > for layer and size settings.
        </p>
      </li>
    </ol>
  </section>

  <section class="photos">
    <div class="section-head">
      <h2>Cut on a real laser</h2>
    </div>
    <div class="photo-grid">
      {
        photos.map((m) => (
          <figure class="photo">
            <img src={`/photos/${m.slug}.webp`} alt={m.photo.alt} loading="lazy" width="900" height="600" />
            <figcaption>
              <a href={`/models/${m.slug}/`}>{m.title}</a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="features">
    <h2>Built for laser cutting</h2>
    <dl>
      {
        FEATURES.map(([t, snippet, text, href]) => (
          <div>
            <dt>
              <a href={href}>{t}</a>
            </dt>
            <dd>
              <pre class="code inline"><code set:html={highlight(snippet)} /></pre>
              <p set:html={text} />
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="showcase">
    <div class="section-head">
      <h2>Made with KerfScript</h2>
      <a href="/models/">All {models.length} models</a>
    </div>
    <div class="model-grid">{featured.map((m) => <ModelCard model={m} />)}</div>
  </section>

  <section class="compare">
    <div>
      <h2>Familiar to OpenSCAD users</h2>
      <p>
        KerfScript uses syntax familiar to OpenSCAD users, with features for laser cutting.
        Use modules, functions and loops to build reusable 2D designs.
      </p>
      <p>
        Existing OpenSCAD files may need changes to run in KerfScript. <a href="/docs/openscad/">Read the OpenSCAD guide</a>.
      </p>
    </div>
    <Fragment
      set:html={code(`use <kerf/box>\n\n$thickness = 3;\n$kerf = 0.15;\n\nbox([120, 80, 50], lid = true);`)}
    />
  </section>

  <section class="where">
    <h2>Where it runs</h2>
    <div class="where-grid">
      <div>
        <h3>In the browser</h3>
        <p>
          Try a design in the <a href="/playground/">playground</a>. It runs in your browser, with nothing to install.
        </p>
      </div>
      <div>
        <h3>On MyLaserTools</h3>
        <p>
          Create and share generators in the MyLaserTools Studio. Other makers can customize them and download the files.
        </p>
      </div>
      <div>
        <h3>On your computer</h3>
        <p>
          Use the <code>kerf</code> command to export designs from your terminal.
          {
            SOURCE_PUBLIC ? (
              <>
                Install it from <a href={NPM_URL}>npm</a>.
              </>
            ) : (
              'The command-line package will be available with the public release.'
            )
          }
        </p>
        <pre class="code plain"><code>npm install --global @mylasertools/kerfscript
kerf render box.kerf -o box.svg</code></pre>
      </div>
    </div>
  </section>

  <section class="licence-note">
    <h2>Use it for your own projects</h2>
    <p>
      KerfScript is available under the GNU AGPL 3.0. You can share or sell your own designs and the
      files you create. Commercial licences are also available for software integrations. <a href="/licence/"
        >Licence details</a
      >
    </p>
  </section>
</Base>
