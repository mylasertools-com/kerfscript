{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kerfscript-site",
  "compatibility_date": "2026-10-01",
  // The built Astro site. The script only redirects http to https.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "routes": [{ "pattern": "kerfscript.mylasertools.com", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
